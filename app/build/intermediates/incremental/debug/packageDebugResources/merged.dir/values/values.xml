<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="orbit_space_background">#070B1A</color>
    <string name="accessibility_service_description">Orbit watches which app comes to the foreground so it can show the quiz gate over apps you have blocked. It does not read screen content.</string>
    <string name="app_name">Orbit</string>
    <style name="Theme.Orbit" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/orbit_space_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>