# Android / Gradle build output
*.iml
.gradle/
/build/
/app/build/
/captures/
.externalNativeBuild/
.cxx/

# Local configuration (machine-specific: SDK path, signing keys)
local.properties

# IDE
/.idea/
.DS_Store

# Kotlin Gradle plugin data
.kotlin/

# Compiled files / logs
*.class
*.log
*.ctxt
.mtj.tmp/

# Java crash logs
hs_err_pid*
replay_pid*

# Keystores / secrets — never commit these
*.jks
*.keystore

# NOTE: The Gradle wrapper JAR (gradle/wrapper/gradle-wrapper.jar) is intentionally
# NOT ignored. It must be committed so the project builds from a fresh clone.
